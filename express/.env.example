PORT=5000
MONGODB_URI=mongodb://localhost:27017/stacksense
NODE_ENV=development

# Python-to-Express internal repository manifest/content API
PLATFORM_INTERNAL_API_SECRET_KEY=internal-platform-secret-key-change-in-production

# Python FastAPI Analysis & Architecture Service Gateway
ANALYSIS_API_BASE_URL=http://localhost:8000/api/v1
ANALYSIS_INTERNAL_API_SECRET_KEY=internal-analysis-secret-key-change-in-production
ANALYSIS_JSON_TIMEOUT_MS=15000
ANALYSIS_SSE_TIMEOUT_MS=300000

# Phase 5 Platform Transport & Intelligence Gateway (optional overrides)
# INTELLIGENCE_QUERY_MAX_BYTES=32768
# INTELLIGENCE_MAX_FILTER_ELEMENTS=50
# INTELLIGENCE_JSON_REQUEST_MAX_BYTES=131072
# INTELLIGENCE_JSON_RESPONSE_MAX_BYTES=4194304
# INTELLIGENCE_C3_RESPONSE_MAX_BYTES=2097152
# INTELLIGENCE_DIAGRAM_SPEC_MAX_BYTES=16777216
# INTELLIGENCE_DIAGRAM_LAYOUT_MAX_BYTES=33554432
# INTELLIGENCE_DIAGRAM_EXPORT_MAX_BYTES=67108864
# INTELLIGENCE_DIAGRAM_SVG_MAX_BYTES=50331648
# INTELLIGENCE_PDF_MAX_BYTES=67108864
# INTELLIGENCE_METADATA_TIMEOUT_MS=30000
# INTELLIGENCE_LONG_TIMEOUT_MS=120000
# INTELLIGENCE_ARTIFACT_UPSTREAM_TIMEOUT_MS=90000
# INTELLIGENCE_ARTIFACT_RELAY_TIMEOUT_MS=60000
# INTELLIGENCE_ARTIFACT_COMBINED_TIMEOUT_MS=150000
# INTELLIGENCE_MAX_CONCURRENT_ARTIFACT_RELAYS=2
# INTELLIGENCE_ARTIFACT_SPOOL_DIR=/tmp/stacksense-intelligence-spool
