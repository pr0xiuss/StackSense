APP_NAME=StackSense API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql://username:password@localhost:5434/stacksense

CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
ANALYSIS_QUEUE_NAME=analysis.jobs
GRAPH_QUEUE_NAME=graph.projections
GRAPH_MAINTENANCE_QUEUE_NAME=graph.maintenance
GRAPH_WORKER_CONCURRENCY=1
GRAPH_WORKER_PREFETCH_MULTIPLIER=1
GRAPH_BROKER_HEALTH_TIMEOUT_SECONDS=2
GRAPH_RECONCILIATION_INTERVAL_SECONDS=60
GRAPH_RECONCILIATION_PAGE_SIZE=100
GRAPH_DISPATCH_RECOVERY_SECONDS=60
GRAPH_LEASE_DURATION_SECONDS=120
GRAPH_HEARTBEAT_INTERVAL_SECONDS=30
GRAPH_CAPABILITY_TTL_SECONDS=180
GRAPH_RETRY_BACKOFF_SECONDS=15
GRAPH_RECOVERY_BATCH_SIZE=100
GRAPH_PROJECTION_DISPATCH_ENABLED=false
ANALYSIS_WORKER_CONCURRENCY=2
ANALYSIS_WORKER_MAX_TASKS_PER_CHILD=2
ANALYSIS_MAX_RETRIES=3
ANALYSIS_RETRY_BACKOFF_SECONDS=5
ANALYSIS_DISPATCH_RECOVERY_INTERVAL_SECONDS=60
INTERNAL_API_SECRET_KEY=internal-analysis-secret-key-change-in-production
PLATFORM_API_BASE_URL=http://localhost:5000/api/v1/internal
PLATFORM_API_SECRET_KEY=internal-platform-secret-key-change-in-production
PLATFORM_ARTIFACT_FETCH_CONCURRENCY=8

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-development-password-change-in-production
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
NEO4J_CONNECTION_ACQUISITION_TIMEOUT_SECONDS=10
NEO4J_HEALTH_TIMEOUT_SECONDS=2
NEO4J_MAX_CONNECTION_POOL_SIZE=20

# Architecture graph projection candidates (Phase 4 Module 2 Batch 1)
# Measurement candidates only; not frozen production defaults.
GRAPH_PROJECTION_NODE_BATCH_SIZE=500
GRAPH_PROJECTION_RELATIONSHIP_BATCH_SIZE=1000
GRAPH_PROJECTION_QUERY_TIMEOUT_SECONDS=30.0
GRAPH_PROJECTION_CLEANUP_PAGE_SIZE=1000
GRAPH_PROJECTION_CLEANUP_GRACE_SECONDS=86400
GRAPH_PROJECTION_MAX_META_KEY_BYTES=64
GRAPH_PROJECTION_MAX_META_STRING_BYTES=2048
GRAPH_PROJECTION_MAX_META_LIST_ITEMS=64
GRAPH_PROJECTION_MAX_META_RECORD_BYTES=16384
GRAPH_PROJECTION_MAX_PROJECTED_PROPERTIES_BYTES=1048576

# Architecture graph query and exploration API (Phase 4 Module 3 Batch 1)
GRAPH_QUERY_DEFAULT_DEPTH=1
GRAPH_QUERY_MAX_DEPTH=5
GRAPH_QUERY_DEFAULT_NODES=100
GRAPH_QUERY_MAX_NODES=500
GRAPH_QUERY_DEFAULT_EDGES=200
GRAPH_QUERY_MAX_EDGES=1000
GRAPH_QUERY_DEFAULT_PATHS=5
GRAPH_QUERY_MAX_PATHS=25
GRAPH_QUERY_DEFAULT_PAGE_SIZE=50
GRAPH_QUERY_MAX_PAGE_SIZE=100
GRAPH_QUERY_DEFAULT_TIMEOUT_SECONDS=2.0
GRAPH_QUERY_MAX_TIMEOUT_SECONDS=5.0
# Dedicated cursor secret; in production set to a random secret with at least 32 bytes
GRAPH_QUERY_CURSOR_SECRET_KEY=stacksense-insecure-dev-graph-cursor-secret-at-least-32-bytes
GRAPH_QUERY_CURSOR_TTL_SECONDS=900

PARSER_WORKER_COUNT=4
PARSER_WORKER_MAX_REQUESTS=64
