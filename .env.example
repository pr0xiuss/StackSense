APP_NAME=StackSense API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql://username:password@localhost:5434/stacksense

CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
ANALYSIS_QUEUE_NAME=analysis.jobs
GRAPH_QUEUE_NAME=graph.projections
GRAPH_MAINTENANCE_QUEUE_NAME=graph.maintenance
GRAPH_WORKER_CONCURRENCY=1
GRAPH_WORKER_PREFETCH_MULTIPLIER=1
GRAPH_BROKER_HEALTH_TIMEOUT_SECONDS=2
GRAPH_RECONCILIATION_INTERVAL_SECONDS=60
GRAPH_RECONCILIATION_PAGE_SIZE=100
GRAPH_DISPATCH_RECOVERY_SECONDS=60
GRAPH_LEASE_DURATION_SECONDS=120
GRAPH_HEARTBEAT_INTERVAL_SECONDS=30
GRAPH_CAPABILITY_TTL_SECONDS=180
GRAPH_RETRY_BACKOFF_SECONDS=15
GRAPH_RECOVERY_BATCH_SIZE=100
GRAPH_PROJECTION_DISPATCH_ENABLED=false
ANALYSIS_WORKER_CONCURRENCY=2
ANALYSIS_MAX_RETRIES=3
ANALYSIS_RETRY_BACKOFF_SECONDS=5
ANALYSIS_DISPATCH_RECOVERY_INTERVAL_SECONDS=60
INTERNAL_API_SECRET_KEY=internal-analysis-secret-key-change-in-production
PLATFORM_API_BASE_URL=http://localhost:5000/api/v1/internal
PLATFORM_API_SECRET_KEY=internal-platform-secret-key-change-in-production
PLATFORM_ARTIFACT_FETCH_CONCURRENCY=8

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-development-password-change-in-production
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
NEO4J_CONNECTION_ACQUISITION_TIMEOUT_SECONDS=10
NEO4J_HEALTH_TIMEOUT_SECONDS=2
NEO4J_MAX_CONNECTION_POOL_SIZE=20

PARSER_WORKER_COUNT=4
PARSER_WORKER_MAX_REQUESTS=64
